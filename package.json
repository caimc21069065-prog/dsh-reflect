{
  "name": "dsh-reflect",
  "description": "Turn corrections into permanent rules: remember: triggers and auto-detected corrections get a confirm bar, then land in AGENTS.md",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caimc21069065-prog/dsh-reflect.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": ">=20.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-user-questions": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-working-directory": ">=0.2.1-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-fs": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-user-questions": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-rc.3",
    "@types/node": "^24.19.2",
    "typescript": "~5.9",
    "vitest": "^5.0.5"
  }
}
